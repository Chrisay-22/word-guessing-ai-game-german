# Google Cloud Configuration
# Copy this file to .env and fill in your actual values

# GCP Project Configuration
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=europe-west1  # Or your preferred region
GCP_LOCATION=global  # For Vertex AI

# Cloud Storage Configuration
GCS_BUCKET_NAME=your-bucket-name-for-words
GCS_TFSTATE_BUCKET=your-bucket-name-for-terraform-state

# Vertex AI Configuration
VERTEX_AI_MODEL=gemini-2.0-flash-lite-001  # Or your preferred model

# Application Configuration
FLASK_ENV=production
FLASK_SECRET_KEY=your-secret-key-here  # Generate with: python -c "import secrets; print(secrets.token_hex(16))"
PORT=8080
TIMEZONE=Europe/Berlin  # Or your preferred timezone

# Game Configuration
MIN_WORD_LENGTH=4
MAX_WORD_LENGTH=11
MAX_ATTEMPTS=6

# Admin Configuration (Optional)
ADMIN_PASSWORD=your-secure-admin-password
